{
  "name": "site-datum",
  "private": true,
  "version": "1.4.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:site": "node scripts/validate-commercial-site.mjs",
    "test:release-manifest": "node --test scripts/release-manifest-core.node-test.mjs",
    "audit:npm": "npm audit --audit-level=high",
    "audit:c8": "node scripts/c8-preflight.mjs",
    "audit:c8:full": "node scripts/c8-preflight.mjs --full",
    "release:manifest": "node scripts/generate-release-manifest.mjs",
    "audit:production-commerce": "node scripts/validate-production-commerce.mjs",
    "tauri:build:production": "npm run audit:production-commerce && tauri build --features commercial-production --bundles nsis",
    "test:licensing-db": "supabase test db --local supabase/tests/licensing_foundation.sql supabase/tests/stripe_adapter.sql",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.1",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-notification": "^2.4.0",
    "@tauri-apps/plugin-opener": "2.7.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "supabase": "2.118.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^8.0.16",
    "vitest": "^4.0.8"
  }
}
